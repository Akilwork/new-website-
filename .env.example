# ==========================================
# DocMe Monorepo Environment Variables Template
# Copy this file to .env and configure as needed
# ==========================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docme_cms?schema=public"

# Backend API Configuration
PORT=5000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production

# CORS & Client Application Origins
CLIENT_URL=http://localhost:3002
CMS_URL=http://localhost:3003

# Public Client Application URLs
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
